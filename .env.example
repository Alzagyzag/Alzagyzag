# Copy to .env and enter values locally. Never commit .env.
# Without credentials the server starts, but chat is unavailable.
JARVIS_API_TOKEN=
JARVIS_PROVIDER=openai
JARVIS_MODEL=gpt-4o-mini
JARVIS_PROVIDER_API_KEY=
JARVIS_PROVIDER_BASE_URL=https://api.openai.com/v1
JARVIS_DATABASE_PATH=data/jarvis.sqlite3
JARVIS_REQUEST_TIMEOUT_SECONDS=60
JARVIS_MAX_CONCURRENT_REQUESTS=4
# Ollama: provider=ollama, base URL=http://127.0.0.1:11434/v1,
# model=<installed model>; no provider key needed.
# OpenAI-compatible services: provider=openai_compatible and set URL/model/key.
